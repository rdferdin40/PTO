{
    "name": "pto/manager",
    "description": "Employee Leave Management System for XAMPP",
    "type": "project",
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
